# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local (local dev) or set the same keys
# in your hosting platform's Environment Variables (e.g. Vercel).
# These are SERVER-SIDE ONLY. Never prefix them with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Google Apps Script Web App URL (Deploy → Manage deployments → Web app URL).
# Looks like: https://script.google.com/macros/s/XXXXXXXXXXXX/exec
SHEETS_WEBHOOK_URL=

# Shared secret. Must match the WEBHOOK_SECRET Script Property in Apps Script.
# Run setup() in the Apps Script editor; it generates one and prints it in the log.
SHEETS_WEBHOOK_SECRET=

# Public URL of the site (used for SEO canonical/OG tags and sitemap).
# Safe to expose. Example: https://www.example.ma
NEXT_PUBLIC_SITE_URL=
