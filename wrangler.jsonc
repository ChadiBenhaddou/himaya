{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "himaya",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-01",
  // Keep variables added in the dashboard when deploying (otherwise plain-text ones are removed).
  "keep_vars": true,
  "assets": {
    // Output of `next build` (static export).
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Everything except the API is served as static files without running the Worker.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
